# Modelo de Gemini que quieras usar
GEMINI_MODEL=gemini-2.5-flash

# Application
FLASK_ENV=development
APP_HOST=0.0.0.0
APP_PORT=5000
CORS_ORIGINS=*

# LLM provider selection: google | openai | anthropic
LLM_PROVIDER=bedrock

# LLM API Keys (set only the one you use)
GOOGLE_AI_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=

# AWS Bedrock configuration (only needed if using bedrock provider)
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL=us.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.2
BEDROCK_TOP_P=0.9

# Database provider selection: mssql | (future: postgresql, mariadb)
DB_PROVIDER=mssql

# Database (MSSQL) basic params used by runtime and cache builder
DB_HOST=
DB_IP=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_DRIVER=ODBC Driver 18 for SQL Server # Example: ODBC Driver 18 for SQL Server

# DB_HOST=sqlserver_dev
# DB_IP=127.0.0.1
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=TuPassw0rd!
# DB_NAME=SaintMale
# DB_DRIVER=ODBC Driver 18 for SQL Server # Example: ODBC Driver 18 for SQL Server

# Graph/Cache configuration
# Directorio de cache (archivos JSON + vector store + grafo)
GRAPH_CACHE_DIR=cache
# Esquemas permitidos (CSV). Si se deja vacío, se usan defaults internos
GRAPH_ALLOWED_SCHEMAS=comite_mora
# GRAPH_ALLOWED_SCHEMAS=bdi,tesoreria_afc,tesoreria_conciliacion_bancaria,tesoreria_fondo_unico
# Tablas a incluir (CSV) en formato esquema.tabla. Si se establece, se filtrará estrictamente por estas
# GRAPH_INCLUDE_TABLES=
# Tablas a excluir (CSV) en formato esquema.tabla
# GRAPH_EXCLUDE_TABLES=
# Filas de muestra por tabla para construir el cache
GRAPH_SAMPLE_ROWS=300
# Máximo de valores comunes por columna a guardar en cache
GRAPH_MAX_COMMON_VALUES=15

# Optional: Proxy settings if needed by your environment
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1